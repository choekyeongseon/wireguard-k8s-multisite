flowchart TD
    A{"wg show:<br/>recent handshake?"}
    A -->|"no"| B{"idc side<br/>behind FortiGate?"}
    B -->|"yes"| B1["check VIP DNAT +<br/>policy extintf=any"]
    B -->|"no"| B2["check UDP/51820 open +<br/>PostUp iptables, not nft"]
    A -->|"works then dies"| C["set PersistentKeepalive=25<br/>on both peers"]
    A -->|"yes"| D{"remote subnet<br/>reachable from host?"}
    D -->|"no route on host"| E["add static route<br/>via local gateway"]
    D -->|"gateway ok, host fails"| F["check MASQUERADE<br/>-s remote-subnet"]
    D -->|"counters rise, packets drop"| G["rp_filter=2 +<br/>ip_forward=1"]
